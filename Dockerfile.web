# PRI web console — Next.js 15 on Cloud Run.
#
# Next's `standalone` output traces only the files the server actually needs,
# so the runtime image carries neither node_modules nor the build toolchain.

# ---------------------------------------------------------------------------
# Stage 1 — dependencies
# ---------------------------------------------------------------------------
FROM node:22-alpine AS deps

WORKDIR /app
COPY web/package.json web/package-lock.json* ./
RUN npm ci --no-audit --no-fund

# ---------------------------------------------------------------------------
# Stage 2 — build
# ---------------------------------------------------------------------------
FROM node:22-alpine AS builder

WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY web/ ./

# No build-time backend configuration. The browser only ever calls this
# service's own /api/pri proxy, which reads PRI_API_BASE_URL and PRI_API_KEY
# from the environment at request time. One image therefore works against any
# backend URL - which matters because the Cloud Run API URL does not exist
# until after the API service has been created.
ENV NEXT_TELEMETRY_DISABLED=1

RUN npm run build

# ---------------------------------------------------------------------------
# Stage 3 — runtime
# ---------------------------------------------------------------------------
FROM node:22-alpine AS runtime

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=8080

RUN addgroup --system --gid 10001 nodejs \
    && adduser --system --uid 10001 nextjs

WORKDIR /app
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs
EXPOSE 8080

CMD ["node", "server.js"]
