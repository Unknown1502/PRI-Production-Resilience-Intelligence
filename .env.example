# ============================================================
# PRI — Environment Variable Reference
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# ------------------------------------------------------------
# DATABASE_* — PostgreSQL connection
# ------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=pri
DATABASE_USER=pri_user
DATABASE_PASSWORD=changeme
# Full async DSN constructed from the above by config.py;
# override here to use a cloud-managed URL directly.
DATABASE_URL=postgresql+asyncpg://pri_user:changeme@localhost:5432/pri

# ------------------------------------------------------------
# GOOGLE_* — Gemini / Google AI credentials
# ------------------------------------------------------------
# Credentials are NOT configured here. Locally, run:
#     gcloud auth application-default login
# On Cloud Run the service account supplies them. Do not set
# GOOGLE_APPLICATION_CREDENTIALS: PRI does not read it, and if it points at a
# path that is not there the Google auth library raises instead of falling
# back to ADC.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# The Google SDK's own name for the region — read directly, not copied.
GOOGLE_CLOUD_LOCATION=us-central1
# Gemini model tag used by every agent call.
GOOGLE_GENAI_MODEL=gemini-2.5-flash
# true routes the ADK agent through Vertex AI (project + location);
# false uses the Gemini Developer API and requires GOOGLE_API_KEY.
GOOGLE_GENAI_USE_VERTEXAI=true
# Only needed when GOOGLE_GENAI_USE_VERTEXAI=false.
GOOGLE_API_KEY=

# ------------------------------------------------------------
# CONFLUENT_* — Kafka / Confluent Cloud
# ------------------------------------------------------------
CONFLUENT_BOOTSTRAP_SERVERS=pkc-xxxxx.us-east-1.aws.confluent.cloud:9092
CONFLUENT_API_KEY=REPLACE_WITH_API_KEY
CONFLUENT_API_SECRET=REPLACE_WITH_API_SECRET
# No schema registry: events are plain JSON and nothing constructs a registry
# client. Topic names below are read into Settings and logged at startup.
# Topic names
CONFLUENT_TOPIC_PRODUCTION_EVENTS=production.events
CONFLUENT_TOPIC_RECOVERY_REQUESTED=production.recovery.requested
CONFLUENT_TOPIC_RECOVERY_COMPLETED=production.recovery.completed
CONFLUENT_TOPIC_AUDIT=production.audit
CONFLUENT_CONSUMER_GROUP_ID=pri-backend

# ------------------------------------------------------------
# PRI_* — Application-level settings
# ------------------------------------------------------------
PRI_ENV=development
PRI_LOG_LEVEL=INFO
PRI_API_HOST=0.0.0.0
PRI_API_PORT=8000
# Secret used to sign API tokens (JWT). Must be >= 32 chars.
PRI_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
# Maximum number of candidate recovery futures generated per disruption event.
PRI_MAX_CANDIDATE_FUTURES=5
# Approval timeout in seconds before a pending request is auto-expired.
PRI_APPROVAL_TIMEOUT_SECONDS=300
# Base URL for the frontend (used in approval email links, etc.)
PRI_FRONTEND_URL=http://localhost:3000
# Shared key required on every mutating API route, sent as X-API-Key.
# Empty disables the check — acceptable for local development only.
PRI_API_KEY=local-dev-key
# false runs recovery purely deterministically with a templated explanation.
# The hosted demo must survive a Gemini quota error, so this is a real switch.
PRI_AGENT_ENABLED=false
# Exposes the A2A endpoint for watsonx Orchestrate. Off by default.
PRI_A2A_ENABLED=false
# Bearer token Orchestrate presents to the A2A endpoint.
PRI_A2A_TOKEN=
# Where generated call sheets are written. Blank uses ./artifacts/call_sheets.
PRI_ARTIFACT_ROOT=
# The production the demo endpoints reset and drive.
PRI_DEMO_PRODUCTION_ID=film-001
# Deployed commit, stamped by the container build and reported by /health.
GIT_SHA=unknown
